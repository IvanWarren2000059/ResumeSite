<header class="topbar">
  <div class="topbar__inner">
    <a href="/" class="mark" aria-label="Home">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="7.2" stroke="currentColor" stroke-width="1.3"/>
        <line x1="10" y1="4.4" x2="10" y2="10" stroke="currentColor" stroke-width="1.3"/>
      </svg>
      <span><%= site.name %></span>
    </a>

    <button class="navtoggle" id="navToggle" aria-expanded="false" aria-controls="primaryNav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="primaryNav" class="primarynav">
      <a href="/" class="<%= active === 'home' ? 'is-active' : '' %>">Home</a>
      <a href="/systems" class="<%= active === 'systems' ? 'is-active' : '' %>">Systems Developed</a>
      <a href="/hardware" class="<%= active === 'hardware' ? 'is-active' : '' %>">Hardware Experience</a>
      <a href="/cv" class="<%= active === 'cv' ? 'is-active' : '' %>">CV</a>
    </nav>
  </div>
</header>
